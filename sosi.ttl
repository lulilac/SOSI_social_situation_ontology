[] rdf:type owl:AllDifferent ;
   owl:distinctMembers ( sosi:eyeContact sosi:bodyLanguage sosi:deicticGesture sosi:iconicGesture sosi:symbolicGesture sosi:laughter sosi:crying ) .


#################################################################
#    Deprecated 2.0.0 aliases
#################################################################
#
#  Every IRI that appeared in 2.0.0 and was renamed in 3.0.0 survives here as
#  an owl:deprecated alias, so that identifiers printed in the SOSI papers and
#  hardcoded in existing annotation sets continue to resolve. Do not use these
#  in new work; see migration-v2-to-v3.csv.

sosi:SocialBackground rdf:type owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass sosi:CrowdDensity ;
    rdfs:label "Social background [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.1.0. Use sosi:CrowdDensity. This was the 3.0.0 name for the crowd-density dimension; 3.1.0 restored the shorter sosi:CrowdDensity."@en .

sosi:Crowd rdf:type owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass sosi:LargeGroup ;
    rdfs:label "Crowd [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.1.0. Merged into sosi:LargeGroup, which now covers both individually-countable large groups and uncountable crowds (11+ participants); the countability boundary that previously separated them was removed."@en .

sosi:Speaking rdf:type owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass sosi:SpeechPresent ;
    rdfs:label "Speaking [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.0.0. The dimension root is now sosi:SpeechActivity, which additionally covers sosi:SpeechAbsent; the old class corresponded to the speech-present branch, so it is aliased to sosi:SpeechPresent."@en .

sosi:NonVerbalCommunication rdf:type owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass sosi:NonverbalCue ;
    rdfs:label "Nonverbal communication [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.0.0. Use sosi:NonverbalCue. Note the narrowed scope: sosi:GroupProxemics, sosi:RelativeBodyPlacement and sosi:NonverbalSignaling are no longer subclasses."@en .

sosi:NonVerbalVocalization rdf:type owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass sosi:NonverbalVocalization ;
    rdfs:label "Nonverbal vocalization [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.0.0 in favour of the consistently capitalised sosi:NonverbalVocalization."@en .

sosi:hasSocialBackground rdf:type owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty sosi:hasCrowdDensity ;
    rdfs:label "has social background [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.1.0. Use sosi:hasCrowdDensity. This was the 3.0.0 name for the property."@en .

sosi:hasCrowdContextBg rdf:type owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty sosi:hasCrowdDensity ;
    rdfs:label "has crowd context background [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.0.0 (was the 2.x name). Use sosi:hasCrowdDensity. Retained because this IRI is cited in the SOSI paper."@en .

sosi:hasPhysicalType rdf:type owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty sosi:hasEnvironmentType ;
    rdfs:label "has physical environment type [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.0.0. Use sosi:hasEnvironmentType."@en .

sosi:hasPurpose rdf:type owl:DatatypeProperty ;
    owl:deprecated true ;
    owl:equivalentProperty sosi:hasPurposeDescription ;
    rdfs:label "has purpose (free text) [deprecated]"@en ;
    rdfs:comment "Deprecated in 3.0.0. Use sosi:hasPurposeDescription, which no longer reads as a variant of sosi:hasInteractionPurpose."@en .

sosi:intimate rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    owl:sameAs sosi:intimateProxemics ;
    rdfs:comment "Deprecated in 3.0.0. Use sosi:intimateProxemics."@en .

sosi:personal rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    owl:sameAs sosi:personalProxemics ;
    rdfs:comment "Deprecated in 3.0.0. Use sosi:personalProxemics."@en .

sosi:social rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    owl:sameAs sosi:socialProxemics ;
    rdfs:comment "Deprecated in 3.0.0. Use sosi:socialProxemics — an unqualified 'social' individual denoting a distance band invites collision."@en .

sosi:public rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    owl:sameAs sosi:publicProxemics ;
    rdfs:comment "Deprecated in 3.0.0. Use sosi:publicProxemics."@en .

sosi:crowd rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    owl:sameAs sosi:largeGroup ;
    rdfs:comment "Deprecated in 3.1.0. Use sosi:largeGroup, which now covers crowds as well (the large-group/crowd distinction was removed)."@en .
